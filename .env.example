# Copy to .env and fill in. Never commit .env.

# ---- Brand (placeholders until the name is decided)
BRAND_NAME=Thruwear
BRAND_TAGLINE=Wear it thru.
BRAND_DOMAIN=localhost
SUPPORT_EMAIL=hello@example.com
# yellow-black | cobalt | ember
THEME=yellow-black

# ---- Core
# production refuses to start with the default SECRET_KEY
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
# true behind HTTPS
COOKIE_SECURE=false
# IP of your reverse proxy (Caddy, nginx...). Only that address may say who the client is
# (X-Forwarded-For); anything else could fake its IP and dodge the rate limits.
FORWARDED_ALLOW_IPS=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
POSTGRES_PASSWORD=vestiti
SEED_ON_START=true
# at each start, delete guest accounts with no trips idle this many days (0 = never)
PRUNE_GUESTS_DAYS=30
# First admin (optional; created/updated at startup). Admin rights come only from here
# or `python -m app.cli create-admin`, never from registering with an email.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Email (password reset and sign-in links). Empty SMTP_HOST: nothing is sent.
# To test on this PC without email, DEV_EMAIL_LINKS=true shows the link on screen, only when
# the app is opened as http://localhost:8000 (never from the network or a tunnel) and never
# for an admin account.
DEV_EMAIL_LINKS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=

# ---- Local AI model (OpenAI-compatible server: Ollama, llama.cpp, vLLM, LM Studio)
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=hf.co/unsloth/Qwen3-8B-GGUF:Q4_K_M
LLM_API_KEY=local
LLM_TIMEOUT_S=60
# Long pasted itineraries (up to 50,000 characters): context window asked from Ollama and
# how long to wait. On a GPU with less than 10 GB, use LLM_NUM_CTX_MAX=16384.
# LLM_API: auto | ollama | openai | anthropic. With anthropic, Claude writes the days of a booked
# trip (paid, per use): LLM_API=anthropic, LLM_API_KEY=<your key>, LLM_MODEL=claude-sonnet-5-5
# (or claude-opus-5-5, claude-haiku-5-5); LLM_EFFORT=low|medium|high. See docs/AI_SETUP.md.
LLM_API=auto
LLM_EFFORT=medium
LLM_NUM_CTX_MAX=32768
LLM_LONG_TIMEOUT_S=600

# ---- Weather (Open-Meteo, free for non-commercial use; commercial launch needs their API plan)
WEATHER_ENABLED=true

# ---- Affiliate networks (leave empty: links still work, just without commission)
AMAZON_ASSOCIATE_TAG=
AMAZON_DOMAIN=amazon.de
AWIN_PUBLISHER_ID=
IMPACT_ACCOUNT_SID=
CJ_PUBLISHER_ID=
AVANTLINK_AFFILIATE_ID=
# FlexOffers deep link from its link builder, with {url} (the shop page) and {click} (our id)
FLEXOFFERS_LINK_TEMPLATE=
# Program/merchant id per shop when the product file has none. Default: evo=10270 (evo on AvantLink).
# Add Decathlon US's FlexOffers program id when approved, e.g. evo=10270;Decathlon US=678
# MERCHANT_PROGRAM_IDS=evo=10270
# Which shops a new traveller sees: us (USD, evo + Decathlon US) or eu (EUR, Bergfreunde...)
DEFAULT_MARKET=us
# Tours and excursions at each stop of the ready-made itineraries
GETYOURGUIDE_PARTNER_ID=
VIATOR_PID=
VIATOR_MCID=

# ---- Flights (docs/FLIGHTS.md). All empty = the flight page shows links only.
# Recent prices on each leg (Travelpayouts / Aviasales Data API, free)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Every flight of the day per leg, and booking (Duffel). duffel_test_... = test data, test bookings.
# A live token searches real flights; booking stays off in the code until payments are set up.
DUFFEL_ACCESS_TOKEN=
