{"_doc":"World treks (generated by tools/trails/world_tail.py from OpenStreetMap, ODbL, and the Copernicus DEM; never edit by hand). geo.enc: encoded polyline of lat, lon, metres.","trails":[{"id":"il-osm-282071","name":"Israel National Trail","country":"IL","base":"Eilat","region":"itc","kind":"day","days":1,"shape":"one_way","osm":282071,"router":"auto","points":[{"id":"start","name":"Start","lat":29.59498,"lon":34.90752,"role":"start"},{"id":"top","name":"Highest point, 661 m","lat":29.58858644518622,"lon":34.88070132888269,"role":"point"},{"id":"goal","name":"End","lat":29.53935,"lon":34.88745,"role":"goal"}],"tier":"B","difficulty":"moderate","glacier":false,"months":[1,2,3,4,10,11,12],"hours":[3.5,4.5],"why":"The Israel National Trail, is a hiking path that was inaugurated in 1995. The trail crosses the entire country of Israel.","sources":["https://en.wikipedia.org/wiki/Israel_National_Trail","https://www.openstreetmap.org/relation/282071","https://hiking.waymarkedtrails.org/#route?id=282071"],"scores":{"effort":2,"nature":3,"culture":0,"relax":2,"history":0,"landscape":3},"rank":5},{"id":"il-osm-7121629","name":"Valley of Springs Trail","country":"IL","base":"Afula","region":"itc","kind":"multiday","days":12,"shape":"out_and_back","osm":7121629,"router":"auto","points":[{"id":"start","name":"Start","lat":32.46561,"lon":35.51136,"role":"start"},{"id":"goal","name":"Top, 411 m","lat":32.4638,"lon":35.43055,"role":"goal"}],"tier":"B","difficulty":"hard","glacier":false,"months":[3,4,5,10,11],"hours":[70.0,95.0],"why":"It is a long, circular walking trail that spans the entire valley of the Nile for about 145 kilometers. The trail is marked by the Committee on the Ways of Israel in the Society for the Protection of Nature, and is the result of an initiative of the Valley of the Nile Regional Council.","sources":["https://he.wikipedia.org/wiki/שביל_עמק_המעיינות","https://www.openstreetmap.org/relation/7121629","https://hiking.waymarkedtrails.org/#route?id=7121629"],"scores":{"effort":5,"nature":4,"culture":0,"relax":0,"history":0,"landscape":4},"rank":4},{"id":"il-osm-568661","name":"Golan Trail","country":"IL","base":"Tiberias","region":"itc","kind":"multiday","days":7,"shape":"one_way","osm":568661,"router":"auto","points":[{"id":"start","name":"Start","lat":32.77237,"lon":35.68447,"role":"start"},{"id":"top","name":"Highest point, 1,521 m","lat":33.277116353462866,"lon":35.76311116159268,"role":"point"},{"id":"goal","name":"End","lat":33.1332,"lon":35.78209,"role":"goal"}],"tier":"B","difficulty":"hard","glacier":false,"months":[3,4,5,10,11],"hours":[40.0,54.5],"why":"The Golan Path is a long walking path of about 125 km at Golan Heights. The route, originally 120 km long, was inaugurated on May 24, 2007, after a five-month marking operation by the Golan Tourism Association's Committee for the Paths of Israel at the Golan Nature Conservancy.","sources":["https://he.wikipedia.org/wiki/שביל_הגולן","https://www.openstreetmap.org/relation/568661","https://hiking.waymarkedtrails.org/#route?id=568661"],"scores":{"effort":5,"nature":4,"culture":0,"relax":0,"history":0,"landscape":5},"rank":4},{"id":"il-osm-6148296","name":"Tour of Makhtesh Ramon","country":"IL","base":"Mitzpe Ramon","region":"itc","kind":"multiday","days":7,"shape":"one_way","osm":6148296,"router":"auto","points":[{"id":"start","name":"Start","lat":30.51332,"lon":34.60896,"role":"start"},{"id":"goal","name":"End","lat":30.61433,"lon":34.80552,"role":"goal"}],"tier":"B","difficulty":"hard","glacier":false,"months":[1,2,3,4,5,10,11,12],"hours":[37.0,50.0],"why":"The path around Ramón is a circular trail of about 130 kilometers in length in the Negev, surrounding Ramón. The path was marked in 2016 and in the same year a road map and a book describing the path were made. The path was started in 2010 by a Taoba, a resident of Ramón.","sources":["https://he.wikipedia.org/wiki/שביל_סובב_מכתש_רמון","https://www.openstreetmap.org/relation/6148296","https://hiking.waymarkedtrails.org/#route?id=6148296"],"scores":{"effort":5,"nature":4,"culture":0,"relax":0,"history":0,"landscape":4},"rank":4},{"id":"il-osm-2860967","name":"Sea to Sea Hiking Trail","country":"IL","base":"Nahariyya","region":"itc","kind":"multiday","days":5,"shape":"one_way","osm":2860967,"router":"auto","points":[{"id":"start","name":"Start","lat":33.02486,"lon":35.32442,"role":"start"},{"id":"top","name":"Highest point, 1,172 m","lat":32.999608022354636,"lon":35.40746483234026,"role":"point"},{"id":"goal","name":"End","lat":32.85484,"lon":35.53224,"role":"goal"}],"tier":"B","difficulty":"hard","glacier":false,"months":[3,4,5,10,11],"hours":[24.0,33.0],"why":"The Sea to Sea Trail is a hiking path that crosses the north of Israel. Its western end is in the Mediterranean Sea at Achziv, near the Lebanese border in the far north of the country, and it extends to the Sea of Gallilee, a length of approximately 71 km.","sources":["https://en.wikipedia.org/wiki/Sea_to_Sea_Hiking_Trail","https://www.openstreetmap.org/relation/2860967","https://hiking.waymarkedtrails.org/#route?id=2860967"],"scores":{"effort":5,"nature":4,"culture":0,"relax":0,"history":0,"landscape":5},"rank":4},{"id":"il-osm-11518999","name":"The Sharon Trail","country":"IL","base":"Tel Aviv","region":"","kind":"multiday","days":3,"shape":"one_way","osm":11518999,"router":"auto","points":[{"id":"start","name":"Start","lat":32.12498,"lon":34.88747,"role":"start"},{"id":"goal","name":"End","lat":32.39812,"lon":34.87059,"role":"goal"}],"tier":"B","difficulty":"hard","glacier":false,"months":[3,4,5,6,9,10],"hours":[13.5,18.5],"why":"The Sharon Trail is a long hiking/biking route in the Sharon region of the State of Israel.","sources":["https://www.openstreetmap.org/relation/11518999","https://hiking.waymarkedtrails.org/#route?id=11518999"],"scores":{"effort":5,"nature":3,"culture":0,"relax":0,"history":0,"landscape":2},"rank":4},{"id":"il-osm-14730532","name":"Jerusalem Trail","country":"IL","base":"Jerusalem",